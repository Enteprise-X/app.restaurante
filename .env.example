# Copie para .env.local
VITE_APP_NOME_EMPRESA=Enterprise X
VITE_APP_NOME_APP=Orion
VITE_APP_DESCRICAO_APP=Sistema Restaurante
VITE_APP_VERSAO_APP=1.0.0
VITE_APP_SIGLA_SISTEMA=ORI
VITE_APP_PORT=3001
VITE_APP_URL_BASE=http://localhost:3001

# ============================================
# AMBIENTE — local | homolog
# Troque só estas linhas (não precisa alterar URL).
# O SPA só fala com o Gateway; oAuth/Core/API vêm atrás dele.
# ============================================
VITE_GATEWAY_AMBIENTE=homolog
VITE_ORION_AMBIENTE=homolog
VITE_OAUTH_AMBIENTE=homolog

# Opcional: só usado se nenhum *AMBIENTE* estiver definido
# VITE_GATEWAY_URL=http://localhost:8080

# Deve ser IGUAL a FRONTEND_SECRET_TOKEN do Gateway
